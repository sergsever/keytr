<Window x:Class="Keytr.MainWindow"
        
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Keytr"
        xmlns:views="clr-namespace:Keytr.Views"
        xmlns:viewmodels="clr-namespace:Keytr.ViewModels"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <viewmodels:MainVM/>
    </Window.DataContext>
    <Grid>
        <Label Content="{Binding Path=Title, Mode=TwoWay}" Width="150" Height="40" VerticalAlignment="Top" HorizontalAlignment="Center"></Label>

        <TextBlock Width="60" Height="60" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding Letter}" Background="{Binding LetterColor}"/>
        <Label Content="{Binding ElapsedTime}" HorizontalAlignment="Left" Margin="28,64,0,0" VerticalAlignment="Top" Width="150" FontSize="18" />
        <TextBlock HorizontalAlignment="Left" Margin="340,348,0,0" TextWrapping="Wrap" Text="{Binding ErrorLetter}" Height="60" Width="60" FontSize="18" VerticalAlignment="Top" Background="{Binding KeyError}" RenderTransformOrigin="0.675,0.178"/>
        <Button Content="Stop" Command="{Binding StopComand}" HorizontalAlignment="Left" Margin="673,388,0,0" VerticalAlignment="Top"/>
        <TextBox HorizontalAlignment="Left" Margin="49,303,0,0" TextWrapping="Wrap" Text="{Binding Entered}" VerticalAlignment="Top" Width="716"/>

    </Grid>
</Window>
