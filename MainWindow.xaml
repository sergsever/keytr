<Window x:Class="Keytr.MainWindow"
        
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Keytr"
        xmlns:views="clr-namespace:Keytr.Views"
        xmlns:viewmodels="clr-namespace:Keytr.ViewModels"
        Title="MainWindow" Height="450" Width="800">
        <Window.DataContext>
        <viewmodels:MainVM/>
        </Window.DataContext>
    <Grid>
        <Label Content="{Binding Path=Title, Mode=TwoWay}" Width="150" Height="40" VerticalAlignment="Top" HorizontalAlignment="Center"></Label>
        <TextBlock Width="60" Height="60" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding Path=Letter, Mode=TwoWay}" Background="{Binding LetterColor}"/>


    </Grid>
</Window>
