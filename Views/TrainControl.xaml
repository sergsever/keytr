<UserControl x:Class="Keytr.Views.TrainControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Keytr.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Label Content="{Binding Title}" HorizontalAlignment="Left" Margin="184,38,0,0" VerticalAlignment="Top"/>
        <TextBlock HorizontalAlignment="Left" Margin="312,189,0,0" TextWrapping="Wrap" Text="{Binding Path=Letter, Mode=TwoWay, NotifyOnSourceUpdated=True}" FontSize="30" VerticalAlignment="Top"/>

    </Grid>
</UserControl>
